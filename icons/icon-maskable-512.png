<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 1000 1000">
  <defs>
    <linearGradient id="chalkShadow" x1="590" y1="887" x2="720" y2="1000" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#D99B00" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#F4B400" stop-opacity="0"/>
    </linearGradient>
    <clipPath id="boardClip">
      <rect x="113" y="113" width="774" height="774"/>
    </clipPath>
  </defs>

  <!-- Fondo amarillo completo sin transparencia (zona de sangrado maskable) -->
  <rect width="1000" height="1000" fill="#F4B400"/>

  <!-- Contenido escalado al 82% centrado para respetar la zona segura (safe zone) -->
  <g transform="translate(500, 500) scale(0.82) translate(-500, -500)">
    <!-- Sombra diagonal proyectada por la tiza sobre el marco amarillo -->
    <polygon points="590,887 795,887 920,1012 715,1012" fill="url(#chalkShadow)"/>

    <!-- Pizarra verde -->
    <rect x="113" y="113" width="774" height="774" fill="#1E9E5A"/>

    <!-- Borde superior sutil de profundidad de la pizarra -->
    <rect x="113" y="113" width="774" height="10" fill="#18864B"/>

    <!-- Siluetas dentro de la pizarra -->
    <g clip-path="url(#boardClip)">
      <!-- Silueta izquierda -->
      <circle cx="315" cy="482" r="56" fill="#7AC39B"/>
      <path d="M 205,645 L 205,612 C 205,570 254,548 315,548 C 376,548 425,570 425,612 L 425,645 Z" fill="#7AC39B"/>

      <!-- Silueta derecha -->
      <circle cx="685" cy="482" r="56" fill="#7AC39B"/>
      <path d="M 575,645 L 575,612 C 575,570 624,548 685,548 C 746,548 795,570 795,612 L 795,645 Z" fill="#7AC39B"/>

      <!-- Silueta central -->
      <circle cx="500" cy="422" r="76" fill="#F1F3F4"/>
      <path d="M 342,645 L 342,598 C 342,542 412,512 500,512 C 588,512 658,542 658,598 L 658,645 Z" fill="#F1F3F4"/>
    </g>

    <!-- Tiza blanca en el borde inferior derecho -->
    <rect x="590" y="845" width="205" height="42" fill="#F1F3F4"/>
    <rect x="590" y="845" width="205" height="6" fill="#FFFFFF"/>
  </g>
</svg>
